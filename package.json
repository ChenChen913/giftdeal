{
  "name": "giftdeal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "cross-env APP_ENV=test node --import tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "smoke": "node scripts/smoke.mjs",
    "db:local": "node scripts/dev-db.mjs",
    "dev:local": "node scripts/dev-all.mjs",
    "cf:build": "cross-env BUILD_TARGET=cloudflare opennextjs-cloudflare build",
    "cf:preview": "cross-env BUILD_TARGET=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "cross-env BUILD_TARGET=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "prisma generate && patch-package",
    "test:e2e": "npm run build:test && playwright test",
    "test:e2e:report": "playwright show-report",
    "db:seed:reset": "tsx prisma/seed.ts --reset",
    "build:test": "cross-env NEXT_PUBLIC_E2E_BUILD=1 next build",
    "check:prod-guard": "node scripts/check-prod-guard.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.19",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "patch-package": "^8.0.1",
    "pglite-server": "^0.1.5",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.162.0"
  }
}

# ============================================================
# 复制为 .env（或 .env.local）后按需修改
#
# APP_ENV 决定安全策略：
#   development / test → 允许 mock 短信、固定验证码、默认隐私密码
#   production         → 禁止以上全部，缺配置直接拒绝启动
# 未设置时按 NODE_ENV 推断（production 构建 = production）。
# ============================================================
APP_ENV="development"

# PostgreSQL 连接串（本地 / Neon / 自建均可）
DATABASE_URL="postgresql://giftdeal:giftdeal@localhost:5432/giftdeal?schema=public"

# Prisma CLI 专用：migrate / seed 走直连串（Neon 的 -pooler 串不支持 DDL）
DIRECT_URL="postgresql://giftdeal:giftdeal@localhost:5432/giftdeal?schema=public"

# Better Auth：生产环境要求至少 32 字符，用 openssl rand -base64 32 生成
BETTER_AUTH_SECRET="请替换为 openssl rand -base64 32 的输出"
BETTER_AUTH_URL="http://localhost:3000"

# 邀请链接域名
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 短信通道：mock（验证码打印在开发日志）| tencent（腾讯云短信）
# 生产环境必须填 tencent，填 mock 会导致服务拒绝启动
SMS_PROVIDER="mock"
OTP_MOCK_CODE="123456"
# 固定验证码开关：仅 development / test 生效；生产环境即使设为 true 也会被拒绝启动
OTP_ALLOW_FIXED_CODE="true"

# ---------- 腾讯云短信（SMS_PROVIDER=tencent 时必填）----------
# 申请步骤见 docs/05-sms-setup.md
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
# 短信控制台的 SDK AppID，1400 开头
TENCENT_SMS_SDK_APP_ID=""
# 审核通过的签名，如「礼金账本」
TENCENT_SMS_SIGN_NAME=""
# 验证码模板 ID
TENCENT_SMS_TEMPLATE_ID=""
TENCENT_SMS_REGION="ap-guangzhou"

# 内部账号：登录框填 admin 即可进入；仅非生产环境生效，生产环境会被拒绝启动
ALLOW_ADMIN_LOGIN="true"
ADMIN_LOGIN_PASSWORD="123456"

# 隐私模式解锁密码（仅服务端校验，不会进入前端打包产物）
# 生产环境必填，至少 8 位，不能是重复字符 / 连续数字 / 常见弱口令
PRIVACY_PASSWORD="331633"

# 允许手机通过局域网 IP 访问（仅本地演示；生产环境会被拒绝启动）
ALLOW_LAN_ACCESS="true"

# 登录页底部的演示账号提示。生产构建默认隐藏；设为 true 可强制显示
NEXT_PUBLIC_SHOW_DEMO_HINT="true"
